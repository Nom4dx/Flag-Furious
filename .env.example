# Copy values into the process environment; this file is documentation, not auto-loaded.
HUB_STORAGE=./storage
HUB_PLUGINS=./plugins
HUB_MAX_UPLOAD=1073741824
HUB_MAX_CASE_BYTES=4294967296
HUB_MAX_ASSETS=1024
# Maximum assets traversed by one recursive job; independent from case retention.
HUB_MAX_PIPELINE_ASSETS=128
HUB_BYTE_BUDGET=1073741824
HUB_TIMEOUT=120
HUB_MEMORY_MB=1024
# Cap for plugin-declared temporary workspace; distinct from exported artifacts.
HUB_MAX_WORKSPACE_BYTES=1073741824
# Colon-separated absolute paths to JSON arrays of additional signature rules.
HUB_SIGNATURE_FILES=
