{
  "id": "host-artifact-forensics",
  "name": "Host Artifact Forensics",
  "version": "0.1.0",
  "author": "RootRunners",
  "description": "Inventario SQLite e analisi offline di cronologia/download browser Chromium, Firefox e Safari",
  "entrypoint": "entrypoint.py",
  "class": "Plugin",
  "domains": ["host_forensics", "browser_forensics", "sqlite_forensics", "timeline"],
  "supported_asset_types": ["file", "directory"],
  "capabilities": [
    "sqlite_database_inventory",
    "sqlite_wal_snapshot",
    "browser_history",
    "browser_downloads",
    "domain_entities",
    "timeline",
    "flag_search",
    "coverage_reporting",
    "visualizations"
  ],
  "dependencies": [],
  "python_dependencies": [],
  "binaries": [],
  "optional_binaries": [],
  "execution_mode": "isolated",
  "requires_network": false,
  "requires_root": false,
  "permissions": [],
  "timeout": 300,
  "cpu_seconds": 280,
  "memory_mb": 768,
  "byte_budget": 268435456,
  "output_bytes": 335544320,
  "input_access": "random_access",
  "workspace_bytes": 536870912
}
