{
  "id": "binary-static-analysis",
  "name": "Binary Static Analysis",
  "version": "1.0.0",
  "author": "RootRunners",
  "description": "Analisi statica read-only di eseguibili, firmware, contenitori e file binari raw",
  "entrypoint": "entrypoint.py",
  "class": "Plugin",
  "domains": ["forensics", "malware-analysis", "reverse-engineering", "firmware"],
  "supported_asset_types": ["file", "disk_image", "memory_dump", "firmware", "archive"],
  "capabilities": ["binary_identification", "executable_parsing", "firmware_analysis", "entropy_analysis", "static_disassembly", "embedded_carving", "derived_assets", "structure_graph", "code_graph", "password_request"],
  "aliases": ["bin-analysis", "static-binary"],
  "unlock_capabilities": {"can_request_password": true, "supported_protection_types": ["zipcrypto", "zip_aes", "7z", "rar", "pdf", "firmware"], "broker_plugin": "bruteforce"},
  "dependencies": [],
  "python_dependencies": [],
  "binaries": [],
  "optional_binaries": ["file", "readelf", "objdump", "strings", "binwalk", "yara", "r2", "llvm-objdump", "llvm-readobj", "uefiextract", "unsquashfs", "dtc", "7z"],
  "execution_mode": "isolated",
  "requires_network": false,
  "requires_root": false,
  "permissions": [],
  "timeout": 300,
  "cpu_seconds": 280,
  "memory_mb": 1536,
  "byte_budget": 1073741824,
  "output_bytes": 268435456,
  "input_access": "random_access",
  "workspace_bytes": 536870912,
  "custom_routes": "routes.py",
  "endpoints": [{"path": "/about", "method": "GET", "handler": "about"}]
}
