{
  "id": "log-forensics",
  "name": "Log Forensics",
  "version": "1.0.0",
  "author": "RootRunners",
  "description": "Parsing, normalizzazione, detection correlata, session reconstruction e flag hunting offline su log eterogenei",
  "entrypoint": "entrypoint.py",
  "class": "Plugin",
  "domains": ["forensics", "log-analysis", "threat-hunting", "incident-response", "ctf"],
  "supported_asset_types": ["file", "directory", "text", "json", "log", "archive"],
  "capabilities": ["log_identification", "event_normalization", "timeline", "session_reconstruction", "attack_detection", "anomaly_detection", "sigma", "flag_reconstruction", "derived_assets", "event_graph", "charts"],
  "aliases": ["logs", "log-analysis"],
  "dependencies": [],
  "python_dependencies": [],
  "binaries": [],
  "optional_binaries": ["journalctl", "chainsaw", "hayabusa", "EvtxECmd", "jq", "rg", "zeek", "suricata", "logstash"],
  "execution_mode": "isolated",
  "requires_network": false,
  "requires_root": false,
  "permissions": [],
  "timeout": 300,
  "cpu_seconds": 280,
  "memory_mb": 1536,
  "byte_budget": 1073741824,
  "output_bytes": 268435456,
  "input_access": "random_access",
  "workspace_bytes": 536870912,
  "custom_routes": "routes.py",
  "endpoints": [{"path": "/about", "method": "GET", "handler": "about"}]
}
