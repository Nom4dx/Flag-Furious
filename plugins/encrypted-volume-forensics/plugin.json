{
  "id": "encrypted-volume-forensics",
  "name": "Encrypted Volume Forensics",
  "version": "1.1.0",
  "author": "RootRunners",
  "description": "Analisi read-only di immagini, partizioni e volumi cifrati con supporto prioritario BitLocker/FVE",
  "entrypoint": "entrypoint.py",
  "class": "Plugin",
  "domains": ["forensics", "disk_forensics", "encrypted_volumes", "bitlocker", "ctf"],
  "supported_asset_types": ["file", "disk_image", "memory_dump", "archive"],
  "capabilities": ["partition_analysis", "bitlocker_detection", "fve_metadata", "key_protectors", "hash_extraction", "memory_fvek_extraction", "companion_key_validation", "password_request", "read_only_unlock", "filesystem_analysis", "artifact_extraction", "derived_assets", "flag_search", "structure_graph", "timeline"],
  "aliases": ["bitlocker-forensics", "encrypted-volume"],
  "dependencies": [],
  "python_dependencies": [],
  "binaries": [],
  "optional_binaries": ["dislocker", "dislocker-file", "bdeinfo", "bdemount", "bitlocker2john", "john", "hashcat", "qemu-img", "mmls", "fls", "icat", "fsstat"],
  "execution_mode": "isolated",
  "requires_network": false,
  "requires_root": false,
  "permissions": [],
  "timeout": 900,
  "cpu_seconds": 600,
  "memory_mb": 1024,
  "byte_budget": 1073741824,
  "output_bytes": 536870912,
  "workspace_bytes": 2147483648,
  "input_access": "random_access",
  "custom_routes": "routes.py",
  "endpoints": [{"method": "GET", "path": "/about", "handler": "about"}],
  "unlock_capabilities": {
    "can_request_password": true,
    "supported_protection_types": ["bitlocker", "bitlocker_password", "bitlocker_recovery_password", "bitlocker_bek"],
    "broker_plugin": "bruteforce"
  }
}
