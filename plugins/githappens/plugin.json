{
  "id": "githappens",
  "name": "GitHappens",
  "version": "1.0.0",
  "author": "RootRunners",
  "description": "GitHappens \u2014 adapter Forensic Hub",
  "entrypoint": "plugin.py",
  "class": "Plugin",
  "domains": [
    "forensics",
